[Unit]
Description=Codex WebSocket Agent instance (%i)
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/home/isp/apps/codex-ws-agent-instances/%i
ConditionPathIsSymbolicLink=/home/isp/apps/codex-ws-agent-instances/%i/current

[Service]
Type=simple
User=root
Group=isp
WorkingDirectory=/home/isp/apps/codex-ws-agent-instances/%i
Environment=PATH=/home/isp/apps/nodejs/bin:/home/isp/apps/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/env node /home/isp/apps/codex-ws-agent-instances/%i/agent-client.mjs --validate
ExecStart=/usr/bin/env node /home/isp/apps/codex-ws-agent-instances/%i/agent-client.mjs
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=20s
RuntimeDirectory=codex-ws-agent-%i
RuntimeDirectoryMode=0700
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
