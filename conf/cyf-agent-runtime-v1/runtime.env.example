# Credential-free running service configuration. Host JSON stays outside artifact.
CYF_RUNTIME_V1_API_BASE_URL=https://cyf-api.example.invalid
CYF_RUNTIME_V1_HEARTBEAT_INTERVAL_MS=60000
# Optional existing trusted workspace policy; per-Agent policyId selects its root.
# CYF_RUNTIME_WORKSPACE_POLICIES_FILE=/private/workspace-policies.json
# Enrollment command only, never retain in running service environment:
# CYF_RUNTIME_V1_ENROLLMENT_SECRET_FILE=/private/agent-a/enrollment.secret

# Optional 0600 current-UID-owned JSON for static subjects with controlled images.
# Full subjectKey -> explicit CYF_PROVIDER_* key; never a process-wide key fallback.
# CYF_RUNTIME_PROVIDER_ENVIRONMENTS_FILE=/home/isp/conf/cyf-agent-runtime-v1/providers.json
