# This file contains no credentials. Copy outside the package as a root-only
# systemd EnvironmentFile, then replace only the endpoint and secret-file path.
CYF_RUNTIME_V1_API_BASE_URL=https://cyf-api.example.invalid
# The enrollment secret must be a separate regular 0600 file supplied by the
# controlled deployment channel. Never place its value in this file or a URL.
CYF_RUNTIME_V1_ENROLLMENT_SECRET_FILE=/etc/cyf-agent-runtime-v1/INSTALLATION_ID_REQUIRED.enrollment
# Optional heartbeat cadence; this is not an API deadline.
CYF_RUNTIME_V1_HEARTBEAT_INTERVAL_MS=60000
