[Unit]
Description=CYF Unified Agent Runtime (%i)
After=network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/isp/apps/cyf-agent-runtime-v1/app
Environment=PATH=/home/isp/apps/nodejs/bin:/home/isp/apps/node/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/isp/conf/cyf-agent-runtime-v1/%i.conf
ExecStartPre=/home/isp/apps/cyf-agent-runtime-v1/app/runtime/validate.sh --root /home/isp/apps/cyf-agent-runtime-v1/app --config /home/isp/conf/cyf-agent-runtime-v1/%i.host.json
ExecStart=/home/isp/apps/cyf-agent-runtime-v1/app/node/bin/node /home/isp/apps/cyf-agent-runtime-v1/app/runtime/agent-runtime.mjs run --config /home/isp/conf/cyf-agent-runtime-v1/%i.host.json
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
