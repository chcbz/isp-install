WS_URL=wss://api.chaoyoufan.cn/ws/agent/channel
OPENCLAW_API_KEY=replace-with-api-key
DEFAULT_CODEX_PROFILE=codex-default
CODEX_PROFILES_FILE=/home/isp/apps/codex-ws-agent/codex-profiles.conf
# Optional inline JSON mode:
# CODEX_PROFILES=[{"profileId":"default","agentId":"codex-default","agentName":"Codex","personaName":"Default","codexBin":"/usr/local/bin/codex","codexHome":"/home/isp/apps/codex-ws-agent/.codex-default","codexWorkdir":"/home/isp","codexSandbox":"workspace-write","codexApproval":"never","codexSessionMode":"resume","codexTimeoutMs":900000,"isDefault":true}]

# Optional model fallback; explicit profile/[default] codexModel takes precedence.
# CODEX_MODEL=replace-with-model-id
# The profiles file is polled every 5000ms. .env itself is NOT hot-reloaded.
# CODEX_PROFILE_RELOAD_MS=5000

# A07 isolated coding worktrees. Copy workspace-policies.example.json to a root-owned/controlled
# workspace-policies.json, replace repository/baseRef/trustedRemoteUrl/trustedRemoteRef with trusted values, then enable this line.
# CODEX_WORKSPACE_POLICIES_FILE=/home/isp/apps/codex-ws-agent/workspace-policies.json
# Optional inline trusted policy map (file mode is recommended):
# CODEX_WORKSPACE_POLICIES={"cyf":{"root":"/home/isp/hosts/cyf/agent-workspaces","repository":"/home/isp/hosts/cyf/repository.git","baseRef":"refs/heads/master","trustedRemoteUrl":"https://git.example.com/chaoyoufan/cyf.git","trustedRemoteRef":"refs/heads/master"}}

# Private Workspace File Bridge. Both values are required to enable the bridge.
# The AgentRuntime credential is returned by the current authenticated WebSocket registration and is held only in memory.
# Never configure CODEX_WORKSPACE_FILE_RUNTIME_AUTH_HEADER.
# CODEX_WORKSPACE_FILE_API_ORIGIN=https://api.chaoyoufan.cn
# CODEX_WORKSPACE_FILE_ROOT_DIR=/home/isp/apps/codex-ws-agent/data/private-runs

# Native bounty GENERATE_IMAGE remains undeclared/disabled unless both switches are true,
# the private Workspace File Bridge values above are usable, and the release-local toolchain exists.
# These switches enable the authenticated conversation HTTP-poll executor only; they do not
# prove cost authorization, Provider availability, or successful installation.
CYF_CONVERSATION_HTTP_POLL_ENABLED=false
CYF_CONVERSATION_IMAGEGEN_ENABLED=false

HEARTBEAT_MS=30000
RECONNECT_MAX_MS=1800000

# Durable Protocol v1 command inbox. The service user must be able to create and fsync this directory.
COMMAND_INBOX_DIR=/home/isp/apps/codex-ws-agent/data/inbox
# archive: keep completed/failed command records; delete: delete successful records, archive failures.
COMMAND_INBOX_SUCCESS_POLICY=archive

# Development-preview managed skill installation. Keep disabled unless the matching API preview is enabled.
AGENT_SKILL_INSTALL_ENABLED=false
# Maximum downloaded ZIP bytes and cumulative extracted bytes per installation.
AGENT_SKILL_INSTALL_MAX_BYTES=16777216
AGENT_SKILL_INSTALL_MAX_EXTRACTED_BYTES=67108864

# R01 private managed-host control is inside this runner. RELEASE ONLY; no daemon or public callback.
AGENT_MANAGED_HOST_ENABLED=false
# Exact fixed API tenant/client. Owner may be one exact owner or '*' for validated per-request owners.
# Wildcard never broadens tenant/client and creates owner-isolated homes/workspaces/profiles under the 0700 root.
# Root: existing canonical runner-owned 0700 directory.
AGENT_MANAGED_HOST_ROOT=
AGENT_MANAGED_HOST_TENANT_ID=
AGENT_MANAGED_HOST_CLIENT_ID=
AGENT_MANAGED_HOST_OWNER_JIACN=
# Existing canonical 0700 seed home, private 0600 config.toml/auth.json; NEVER a persona profile home.
AGENT_MANAGED_HOST_TEMPLATE_HOME=
# Absolute trusted executable with app-server initialize/account/read/thread/start support.
AGENT_MANAGED_HOST_CODEX_BIN=
# Existing root:isp 0750 parent, shared only with the API service group; socket remains root:isp 0660.
# Must be absent at startup. Operator may remove an owned stale socket only after runner exit is proven.
AGENT_MANAGED_HOST_SOCKET=
# Existing trusted GitWorkspaceManager policy for task handoff, not a shared writable workdir.
AGENT_MANAGED_HOST_WORKSPACE_POLICY_ID=

# Juyi Hall Fast CHAT is disabled unless all required flags/policy are enabled.
CODEX_CHAT_ENGINE=legacy-codex
CODEX_FAST_CHAT_ENABLED=false
CODEX_APP_SERVER_ENABLED=false
CODEX_TRUE_DELTA_ENABLED=false
# Durable hosted CHAT profile capacity (legacy single-profile fallback values).
CODEX_CHAT_INBOX_MAX_FILES=1024
CODEX_CHAT_INBOX_MAX_BYTES=67108864
# Completed/cancelled payload archive is independent from hot admission; compact dedupe evidence is retained.
CODEX_CHAT_ARCHIVE_MAX_FILES=256
CODEX_CHAT_ARCHIVE_MAX_BYTES=16777216
CODEX_CHAT_ARCHIVE_RETENTION_MS=604800000

# Sharded immutable CHAT dedupe ledger retains recent exact delivery evidence independently of payload archive.
CODEX_CHAT_DEDUPE_MAX_ENTRIES=100000
CODEX_CHAT_DEDUPE_MAX_BYTES=134217728
CODEX_CHAT_DEDUPE_RETENTION_MS=2592000000

# Optional private Operator authorization map for managed controlled-image profiles.
# The file must be an existing canonical absolute path, owned by the service user, with no group/world permissions.
# Every authorization is exact tenant/client/owner/agent/generation/profile scope and carries its own non-overlapping ledger root.
# Managed profiles never inherit controlled-image endpoint, key environment name, model, binding, epoch, or ledger from a default profile.
# AGENT_MANAGED_IMAGE_SCOPES_FILE=/home/isp/apps/codex-ws-agent/managed-image-scopes.json
# Schema v2 may explicitly select GPT_IMAGE_CLI_V1 and must pin the venv invocation path plus
# SHA-256 digests for its resolved Python binary and unchanged run.py/image_gen.py/verifier files.
# The runtime hashes the resolved Python target but launches the configured venv/bin/python path so pyvenv.cfg remains effective.
# Selection is fail-closed and never falls back to the direct HTTP executor.
