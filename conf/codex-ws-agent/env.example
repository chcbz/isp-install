WS_URL=wss://api.chaoyoufan.cn/ws/agent/channel
OPENCLAW_API_KEY=replace-with-api-key
DEFAULT_CODEX_PROFILE=codex-default
CODEX_PROFILES_FILE=/home/isp/apps/codex-ws-agent/codex-profiles.conf
# Optional inline JSON mode:
# CODEX_PROFILES=[{"profileId":"default","agentId":"codex-default","agentName":"Codex","personaName":"Default","codexBin":"/usr/local/bin/codex","codexHome":"/home/isp/apps/codex-ws-agent/.codex-default","codexWorkdir":"/home/isp","codexSandbox":"danger-full-access","codexApproval":"never","codexSessionMode":"resume","codexTimeoutMs":900000,"isDefault":true}]


# A07 isolated coding worktrees. Copy workspace-policies.example.json to a root-owned/controlled
# workspace-policies.json, replace repository/baseRef/remote with trusted values, then enable this line.
# CODEX_WORKSPACE_POLICIES_FILE=/home/isp/apps/codex-ws-agent/workspace-policies.json
# Optional inline trusted policy map (file mode is recommended):
# CODEX_WORKSPACE_POLICIES={"cyf":{"root":"/home/isp/hosts/cyf/agent-workspaces","repository":"/home/isp/hosts/cyf/repository.git","baseRef":"refs/heads/master","remote":{"name":"origin","url":"https://git.example.com/chaoyoufan/cyf.git"}}}

HEARTBEAT_MS=30000
RECONNECT_MAX_MS=1800000

# Durable Protocol v1 command inbox. The service user must be able to create and fsync this directory.
COMMAND_INBOX_DIR=/home/isp/apps/codex-ws-agent/data/inbox
# archive: keep completed/failed command records; delete: delete successful records, archive failures.
COMMAND_INBOX_SUCCESS_POLICY=archive
